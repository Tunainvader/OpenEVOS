{
  // OpenEVOS relay (ADR-0062). Deploy steps: README.md.
  "name": "openevos-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "kv_namespaces": [
    // replace with the id printed by: npx wrangler kv namespace create OAUTH_KV
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "durable_objects": { "bindings": [{ "name": "INSTRUMENT", "class_name": "Instrument" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Instrument"] }],
  "observability": { "enabled": true }
}
